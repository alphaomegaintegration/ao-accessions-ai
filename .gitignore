# Secrets — never commit
.env
.env.*
*.key
*.pem
credentials.json
secrets.*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*~
~$*

# Build/scratch artifacts
*.tmp
*.log
# graphify: commit only the report and the clickable graph
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
# archify: diagram HTML is built in CI
docs/architecture/*.html
